# Copy to .env.local (never committed), or run `npm run db:env` to fill it from the local Supabase
# stack. Only public values belong here: every VITE_ variable is compiled into the app that every
# visitor downloads, and the build refuses any VITE_ variable that is not on the allowlist in
# src/lib/client-env-policy.ts.

VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
