-- Shared setup for the database tests. Each test file includes it with \ir inside its own
-- transaction and rolls back at the end, so nothing here outlives a test.
--
-- Acting as someone: tests.act_as(user) switches to the `authenticated` role with that user's JWT
-- claims, tests.act_as_anon() to `anon`, tests.act_as_service() to `service_role`; `reset role`
-- returns to the test runner (postgres). Switch back with `reset role` before switching again.

create schema tests;
grant usage on schema tests to anon, authenticated, service_role;

-- An Auth user with no profile: signed in, but not a member.
create function tests.create_user()
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (
    id, instance_id, aud, role, email, encrypted_password, email_confirmed_at,
    raw_app_meta_data, raw_user_meta_data, created_at, updated_at
  ) values (
    v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',
    v_id::text || '@test.invalid', '', now(), '{}', '{}', now(), now()
  );
  return v_id;
end;
$$;

-- A member: an Auth user with a profile.
create function tests.create_member(
  p_phone text,
  p_name text default 'পরীক্ষা',
  p_active boolean default true
)
returns uuid
language plpgsql
as $$
declare
  v_id uuid := tests.create_user();
begin
  insert into public.profiles (id, phone, display_name_bn, active)
  values (v_id, p_phone, p_name, p_active);
  return v_id;
end;
$$;

create function tests.act_as(p_user uuid)
returns void
language plpgsql
as $$
begin
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub', p_user, 'role', 'authenticated')::text,
    true
  );
  perform set_config('role', 'authenticated', true);
end;
$$;

create function tests.act_as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('role', 'anon', true);
end;
$$;

create function tests.act_as_service()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'service_role')::text, true);
  perform set_config('role', 'service_role', true);
end;
$$;

grant execute on all functions in schema tests to anon, authenticated, service_role;
